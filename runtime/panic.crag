using File = void; // Avoid declaring the entire `File` structure as it's not relevant;

extern "C" fn fprintf(stream: *File, format: *const u8, ...) -> i32;
extern "C" fn abort() -> void;

when @target_os == "windows" {
// Windows CRT: stderr is accessed via __acrt_iob_func(2)
// (index 0=stdin, 1=stdout, 2=stderr)
extern "C" fn __acrt_iob_func(idx: u32) -> *File;

extern fn __panic__(msg: *const u8, line: i32, col: i32) -> void @noprefix {
    const stderr = __acrt_iob_func(2);
    fprintf(stderr, "PANIC: %s at line %d, col %d\n", msg, line, col);
    abort();
}

}

when @target_os == "macos"{

extern "C" const __stderrp: *File;

extern fn __panic__(msg: *const u8, line: i32, col: i32) -> void @noprefix @noreturn {
  const stderr = __stderrp;
  fprintf(stderr, "PANIC: %s at line %d, col %d\n", msg, line, col);
  abort();
}

}

when @target_os == "linux" {

extern "C" const stderr: *File;
extern "C" const stdout: *File;

extern fn __panic__(msg: *const u8, line: i32, col: i32) -> void @noprefix @noreturn {
  fprintf(stderr, "PANIC: %s at line %d, col %d\n", msg, line, col);
  abort();
}

}
