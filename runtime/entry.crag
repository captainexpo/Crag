extern fn main() -> i32;

extern "C" fn __global_var_init__() -> void @noprefix @weak {
    return;
}

extern "C" fn malloc(size: usize) -> *void;
extern "C" fn free(ptr: *void) -> void;
extern "C" fn strlen(s: *const u8) -> usize;

extern "C" fn fflush(stream: *void) -> i32;

pub extern "C" let __environp: *const u8 = null;
pub extern "C" let __argumentsp: **u8 = null;
pub extern "C" let __argument_count: usize = 0;

extern fn __main_setup(argc: i32, argv: **u8, envp: *const u8) -> i32 @noprefix {

    __environp = envp;
    __argumentsp = argv;
    __argument_count = argc;

    if (&__global_var_init__ != null)
        __global_var_init__();


    let status = main();
    fflush(null);

    return status;
}

when @target_arch == "arm64" {

extern fn _start() -> void @noprefix @naked @noreturn {
    asm volatile (
        "mov x29, #0\n"
        "ldr x0, [sp]\n"
        "add x1, sp, #8\n"
        "add x2, x1, x0, lsl #3\n"
        "add x2, x2, #8\n"
        "bl ___main_setup\n"
        "mov x0, x0\n"
        "bl __exit\n",
        options(nomem, nostack, noreturn)
    );
}

fn _exit(status: i32) -> void @inline @noprefix @noreturn {
    asm volatile (
        "mov x16, #1\n"
        "orr x16, x16, #0x2000000\n"
        "svc #0x80\n",
        in("x0") status,
        options(nomem, nostack, noreturn),
    );
}

}

when @target_arch != "arm64" {

extern fn _start() -> void @noprefix @naked @noreturn {
    asm volatile (
        "xor ebp, ebp\n"
        "mov edi, [rsp]\n"
        "lea rsi, [rsp + 8]\n"
        "lea rdx, [rsp + 16 + rdi*8]\n"
        "xor eax, eax\n"
        "call __main_setup\n"
        "mov edi, eax\n"
        "xor eax, eax\n"
        "call _exit\n",
        options(intel_syntax, nomem, nostack, noreturn)
    );
}

fn _exit(status: i32) -> void @inline @noprefix @noreturn {
    asm volatile (
        "mov rax, 60\n"
        "syscall\n",
        in("rdi") status,
        options(intel_syntax, nomem, nostack, noreturn),
    );
}
}
