import "io.crag" as io;
import "string.crag" as string;

pub fn assert(condition: bool, message: str){
    if (!condition) {
        io.panic(message);
        return;
    }
    io.println(message);
}

pub fn assert_equal<T>(expected: T, actual: T, message: str) {
    if (expected != actual) {
        io.print("[FAIL] ");
        io.print(message);
        io.print(" Expected: ");
        io.print(string.tostring(expected));
        io.print(" Actual: ");
        io.println(string.tostring(actual));
        io.panic("Test failed");
        return;
    }
    io.print("[PASS] ");
    io.println(message);
}

pub fn assert_array_equal<T>(expected: []T, actual: []T, message: str) {
    if (expected.len != actual.len) {
        io.print("[FAIL] ");
        io.print(message);
        io.print(" Expected length: ");
        io.print(string.tostring(expected.len));
        io.print(" Actual length: ");
        io.println(string.tostring(actual.len));
        io.panic("Test failed");
        return;
    }
    for (let i = 0; i < expected.len; i++) {
        if (expected[i] != actual[i]) {
            if (expected.len > 10) {
                io.print("[FAIL] ");
                io.print(message);
                io.print(" Arrays differ at index ");
                io.print(string.tostring(i));
                io.println(". Too many elements to display.");
            } else {
                io.print("[FAIL] ");
                io.print(message);
                io.print(" Arrays differ at index ");
                io.print(string.tostring(i));
                io.print(". Expected: ");
                io.print(string.tostring(expected[i]));
                io.print(" Actual: ");
                io.println(string.tostring(actual[i]));
            }
            return;
        }
    }
    io.print("[PASS] ");
    io.println(message);
}
