pub extern "C" fn memcpy(dest: *void, src: *void, n: usize) -> *void;
pub extern "C" fn memmove(dest: *void, src: *void, n: usize) -> *void;
pub extern "C" fn memset(dest: *void, c: i32, n: usize) -> *void;
pub extern "C" fn strlen(s: *const u8) -> usize;
pub extern "C" fn strcmp(s1: *const u8, s2: *const u8) -> i32;
pub extern "C" fn strncmp(s1: *const u8, s2: *const u8, n: usize) -> i32;
pub extern "C" fn strcpy(dest: *u8, src: *const u8) -> *u8;
pub extern "C" fn strncpy(dest: *u8, src: *const u8, n: usize) -> *u8;
