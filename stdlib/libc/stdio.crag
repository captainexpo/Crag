pub extern "C" fn printf(fmt: *const u8, ...) -> i32;
pub extern "C" fn vprintf(fmt: *const u8, args: *void) -> i32;
pub extern "C" fn puts(s: *const u8) -> i32;
pub extern "C" fn putchar(c: i32) -> i32;
pub extern "C" fn getchar() -> i32;
pub extern "C" fn scanf(fmt: *const u8, ...) -> i32;
pub extern "C" fn sscanf(s: *const u8, fmt: *const u8, ...) -> i32;
pub extern "C" fn fprintf(stream: *void, fmt: *const u8, ...) -> i32;
pub extern "C" fn sprintf(str: *u8, fmt: *const u8, ...) -> i32;
pub extern "C" fn snprintf(str: *u8, size: usize, fmt: *const u8, ...) -> i32;

struct File {
    _ptr:    *u8,
    _cnt:    i32,
    _base:   *u8,
    _flag:   i32,
    _file:   i32,
    _charbuf: i32,
    _bufsiz: i32,
    _tmpfname: *u8,
}

when @target_os == "macos"{
    extern "C" const __stderrp: *File;
    extern "C" const __stdoutp: *File;

    pub let stderr: *File = __stderrp;
    pub let stdout: *File = __stdoutp;
}

when @target_os == "linux" {
    pub extern "C" const stderr: *File;
    pub extern "C" const stdout: *File;
}

when @target_os == "windows"{
    extern "C" fn __acrt_iob_func(idx: u32) -> *File;

    pub let stderr: *File = __acrt_iob_func(2);
    pub let stdout: *File = __acrt_iob_func(1);
}

// File utility functions
pub extern "C" fn fopen(filename: *const u8, mode: *const u8) -> *void;
pub extern "C" fn fclose(file: *void) -> i32;
pub extern "C" fn fread(ptr: *void, size: usize, count: usize, stream: *void) -> usize;
pub extern "C" fn fwrite(ptr: *const void, size: usize, count: usize, stream: *void) -> usize;
pub extern "C" fn fseek(stream: *void, offset: i64, whence: i32) -> i32;
pub extern "C" fn ftell(stream: *void) -> i64;
pub extern "C" fn rewind(stream: *void) -> void;
pub extern "C" fn feof(stream: *void) -> i32;
pub extern "C" fn ferror(stream: *void) -> i32;
pub extern "C" fn fflush(stream: *void) -> i32;
