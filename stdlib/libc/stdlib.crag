pub extern "C" fn malloc(size: usize) -> *void;
pub extern "C" fn calloc(nmemb: usize, size: usize) -> *void;
pub extern "C" fn realloc(ptr: *void, size: usize) -> *void;
pub extern "C" fn free(ptr: *void) -> void;
pub extern "C" fn exit(code: i32) -> void;
pub extern "C" fn abort() -> void;
pub extern "C" fn atoi(s: *const u8) -> i32;
pub extern "C" fn atol(s: *const u8) -> i64;
pub extern "C" fn strtol(s: *const u8, endptr: **u8, base: i32) -> i64;
pub extern "C" fn getenv(name: *const u8) -> *u8;
pub extern "C" fn rand() -> i32;
pub extern "C" fn srand(seed: u32) -> void;
pub extern "C" fn abs(x: i32) -> i32;
pub extern "C" fn labs(x: i64) -> i64;
pub extern "C" fn abort() -> void;
