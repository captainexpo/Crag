import "./libc/string.crag" as cstring;
import "./libc/stdlib.crag" as cstdlib;
import "./libc/stdio.crag" as cstdio;
import "./builtin.crag" as builtin;

pub fn tostring_int(n: i64) -> str {
    let buf: [32]u8 = {0};
    cstdio.snprintf(buf.ptr, 32, "%lld", n);
    return newstr(buf.ptr, cstring.strlen(buf.ptr));
}

pub fn tostring_uint(n: u64) -> str {
    let buf: [32]u8 = {0};
    cstdio.snprintf(buf.ptr, 32, "%llu", n);
    return newstr(buf.ptr, cstring.strlen(buf.ptr));
}

pub fn tostring_float(f: f64) -> str {
    let buf: [32]u8 = {0};
    cstdio.snprintf(buf.ptr, 32, "%g", f);
    return newstr(buf.ptr, cstring.strlen(buf.ptr));
}

pub fn tostring_bool(b: bool) -> str {
    if (b) {
        return "true";
    } else {
        return "false";
    }
}

pub fn tostring_char(c: u8) -> str {
    let buf: [2]u8 = {0};
    buf[0] = c;
    buf[1] = 0;
    return newstr(buf.ptr, 1);
}

pub fn tostring_ptr(ptr: *void) -> str {
    let buf: [32]u8 = {0};
    cstdio.snprintf(buf.ptr, 24, "%p", ptr);
    return newstr(buf.ptr, cstring.strlen(buf.ptr));
}

pub fn tostring<T>(value: T) -> str {
    when builtin.TypeID:I8 <= typeid(value) && builtin.TypeID:I64 >= typeid(value) {
        return tostring_int(value as i64);
    }
    when builtin.TypeID:U8 <= typeid(value) && builtin.TypeID:USize >= typeid(value) {
        return tostring_uint(value as u64);
    }
    when builtin.TypeID:F32 == typeid(value) || builtin.TypeID:F64 == typeid(value) {
        return tostring_float(value as f64);
    }
    when builtin.TypeID:Bool == typeid(value) {
        return tostring_bool(value);
    }
    when builtin.TypeID:Str == typeid(value) {
        return value;
    }
    when builtin.TypeID:Struct == typeid(value) {
        // Assume struct has tostring method
        return value.tostring();
    }
    when builtin.TypeID:Pointer == typeid(value) {
        return tostring_ptr(value as *void);
    }
    return "";
}

pub fn c_str(s: str) -> *const u8 {
    // Ensure null-terminated, caller owns the memory and must free it
    let len: usize = s.len;
    let buffer: *u8 = cstdlib.malloc(len + 1) as *u8;
    if (buffer == null) {
        return null;
    }
    cstring.memcpy(buffer as *void, s.ptr as *void, len);
    buffer[len] = 0;
    return buffer;
}
