import "./libc/math.crag" as cmath;
pub const PI: f64 = 3.141592653589793238;

pub extern "C" fn sinf (x: f32) -> f32;
pub extern "C" fn cosf (x: f32) -> f32;
pub extern "C" fn sin (x: f64) -> f64;
pub extern "C" fn cos (x: f64) -> f64;
pub extern "C" fn atan2 (x: f64) -> f64;
pub extern "C" fn sqrt (x: f64) -> f64;

pub fn max<T>(a: T, b: T) -> T{
    if (a > b) {
        return a;
    }
    return b;
}

pub fn min<T>(a: T, b: T) -> T{
    if (a < b) {
        return a;
    }
    return b;
}

pub fn abs<T>(a: T) -> T{
    if (a < 0) {
        return -a;
    }
    return a;
}

pub fn sign<T>(a: T) -> T{
    if (a < 0) {
        return -1;
    }
    if (a > 0) {
        return 1;
    }
    return 0;
}

pub fn clamp<T>(a: T, min: T, max: T) -> T{
    if (a < min) {
        return min;
    }
    if (a > max) {
        return max;
    }
    return a;
}
