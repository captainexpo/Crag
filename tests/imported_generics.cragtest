//NAME: Imported Generics
//DESC:
//REQUIRES:mod_test_requires/imported_generic.crag
//BEGIN CODE

import "imported_generic.crag" as ig;
import "stdlib" as std;

fn main() -> i32 {
    let v = ig.Vec2::<f64> { x: 3.0, y: 4.0 };
    std.testing.assert(v.x == 3.0 && v.y == 4.0, "ig.Vec2::<f64> fields should be 3.0 and 4.0");

    let v2 = ig.Vec2::<i32> { x: 30, y: 40 };
    std.testing.assert(v2.x == 30 && v2.y == 40, "ig.Vec2::<i32> fields should be 30 and 40");

    return 0;
}

//END CODE
