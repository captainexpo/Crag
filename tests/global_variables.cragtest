//NAME: Global Variables
//DESC: Verify global constants
//BEGIN CODE
import "stdlib" as std;

const PI = 3.14159;
const E = 2.71828;

const TAU = 2.0 * PI;


fn main(argc: i32, argv: *const *const u8) -> i32 {
    std.testing.assert(PI == 3.14159, "PI should be 3.14159");
    std.testing.assert(E == 2.71828, "E should be 2.71828");
    std.testing.assert(TAU == 2.0 * PI, "TAU should equal 2 * PI");
    return 0;
}
//END CODE
