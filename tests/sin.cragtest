//NAME: Sin/Cos Example
//DESC: verify sine values for common angles.
//BEGIN CODE

import "stdlib" as std;
const PI = 3.14159;

fn sin(x: f64) -> f64 {
  let term = x;
  let sum = term;
  let n: f64 = 1;
  while (n < 10)
  {
      let den: f64 = (2 * n * (2 * n + 1.0));
      term = -term * x * x / den;
      sum = sum + term;
      n = n + 1;
  }
  return sum;
}

fn approx(a: f64, b: f64) -> bool {
    let d: f64 = a - b;
    if (d < 0.0) {
        d = -d;
    }
    return d < 0.01;
}

fn main(argc: i32, argv: *const *const u8) -> i32 {
    std.testing.assert(approx(sin(PI / 2.0), 1.0), "sin(PI/2) should be approximately 1.0");
    std.testing.assert(approx(sin(PI / 6.0), 0.5), "sin(PI/6) should be approximately 0.5");
    std.testing.assert(approx(sin(PI / 4.0), 0.71), "sin(PI/4) should be approximately 0.71");
    return 0;
}

//END CODE
