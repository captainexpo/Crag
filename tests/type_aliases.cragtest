//NAME: Type aliasing
//DESC:
//BEGIN CODE

import "stdlib" as std;

using number = f64;

struct Point {
    x: number,
    y: number,
}

using Test = Point;

fn main() -> i32 {
    let v: number;
    v = 4.0;
    std.testing.assert(v == 4.0, "number alias should behave like f64");
    let p: Test = Test { x: 1.0, y: 2.0 };
    std.testing.assert(p.x + p.y == 3.0, "Test alias fields should sum to 3.0");
    return 0;
}


//END CODE
