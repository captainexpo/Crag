//NAME: Correct casting
//DESC:
//BEGIN CODE

import "stdlib" as std;

fn main(argc: i32, argv: **u8) -> i32 {
    let a: f32 = 5;
    let b: i32 = 3.5;
    std.testing.assert(a == 5.0, "int literal assigned to f32 should cast to 5.0");
    std.testing.assert(b == 3, "float literal assigned to i32 should truncate to 3");
    return 0;
}

//END CODE
