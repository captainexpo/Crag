//NAME: Bitwise and Logical Operators
//DESC: Test bitwise and logical operators
//BEGIN CODE

import "stdlib" as std;

fn main(argc: i32, argv: **u8) -> i32 {
  let a: i32 = 1;
  a <<= 5;
  a ^= 0xFAFAFAFA;
  a >>= 2;
  a = ((a | 0xBAFAFAFA) & (a * 7));
  a ^= a - 5;
  std.testing.assert(a == 15, "bitwise operator chain should result in 15");
  a = ~a + 1;
  std.testing.assert(a == -15, "~a + 1 should negate a to -15");

  // Logical operations b/c why not
  let c: bool = true;
  let d: bool = false;

  std.testing.assert((c && d) == false, "true && false should be false");
  std.testing.assert((c || d) == true, "true || false should be true");
  std.testing.assert((!(c || d) && true) == false, "!(true || false) && true should be false");
  return 0;
}

//END CODE
