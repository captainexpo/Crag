//NAME: ABI - Coerced Struct Shapes (<= 16 bytes)
//DESC: Every SysV x86-64 register shape for small structs, passed to and returned from real C
//REQUIRES_C:abi_coercion_helpers.c
//BEGIN CODE

import "stdlib" as std;

struct V3 { x: f32, y: f32, z: f32, }
struct FatPtr { p: *i64, n: i64, }
struct Quad { a: i32, b: i32, c: i32, d: i32, }
struct IntLong { a: i32, b: i64, }
struct FFI { x: f32, y: f32, i: i32, }
struct III { a: i32, b: i32, c: i32, }
struct LongDouble { a: i64, b: f64, }
struct B3 { a: u8, b: u8, c: u8, }
struct S3 { a: i16, b: i16, c: i16, }

extern "C" fn abi_v3(v: V3) -> V3;
extern "C" fn abi_fatptr(f: FatPtr) -> FatPtr;
extern "C" fn abi_quad(q: Quad) -> Quad;
extern "C" fn abi_intlong(v: IntLong) -> IntLong;
extern "C" fn abi_ffi(v: FFI) -> FFI;
extern "C" fn abi_iii(v: III) -> III;
extern "C" fn abi_longdouble(v: LongDouble) -> LongDouble;
extern "C" fn abi_b3(v: B3) -> B3;
extern "C" fn abi_s3(v: S3) -> S3;
extern "C" fn abi_mixed(a: III, d: f64, b: V3, l: i64, c: FFI) -> f64;

fn main() -> i32 {
    // {float, float, float} -> xmm0 (x,y), xmm1 (z)
    let v3: V3 = abi_v3(V3{ x: 1.0, y: 2.0, z: 3.0 });
    std.testing.assert(v3.x != -1.0, "V3 argument arrived wrong in C");
    std.testing.assert(v3.x == 30.0 && v3.y == 10.0 && v3.z == 20.0, "V3 return came back wrong");

    // {ptr, i64} -> rdi, rsi
    let target: i64 = 7;
    let fp: FatPtr = abi_fatptr(FatPtr{ p: &target, n: 5 });
    std.testing.assert(fp.n != -1, "FatPtr argument arrived wrong in C");
    std.testing.assert(fp.n == 12 && fp.p.* == 7, "FatPtr return came back wrong");

    // {i32 x 4} -> rdi (a|b), rsi (c|d)
    let q: Quad = abi_quad(Quad{ a: 1, b: 2, c: 3, d: 4 });
    std.testing.assert(q.a != -1, "Quad argument arrived wrong in C");
    std.testing.assert(q.a == 4 && q.b == 3 && q.c == 2 && q.d == 1, "Quad return came back wrong");

    // {i32, i64} (padded to 16) -> rdi, rsi
    let il: IntLong = abi_intlong(IntLong{ a: 11, b: 22 });
    std.testing.assert(il.a != -1, "IntLong argument arrived wrong in C");
    std.testing.assert(il.a == 22 && il.b == 44, "IntLong return came back wrong");

    // {float, float, i32} -> xmm0 (x,y), rdi (i)
    let ffi: FFI = abi_ffi(FFI{ x: 1.5, y: 2.5, i: 3 });
    std.testing.assert(ffi.i != -1, "FFI argument arrived wrong in C");
    std.testing.assert(ffi.x == 2.5 && ffi.y == 1.5 && ffi.i == 300, "FFI return came back wrong");

    // {i32, i32, i32} -> rdi (a|b), rsi (c)
    let iii: III = abi_iii(III{ a: 1, b: 2, c: 3 });
    std.testing.assert(iii.a != -1, "III argument arrived wrong in C");
    std.testing.assert(iii.a == 3 && iii.b == 2 && iii.c == 1, "III return came back wrong");

    // {i64, f64} -> rdi, xmm0
    let ld: LongDouble = abi_longdouble(LongDouble{ a: 40, b: 0.5 });
    std.testing.assert(ld.a != -1, "LongDouble argument arrived wrong in C");
    std.testing.assert(ld.a == 42 && ld.b == 2.0, "LongDouble return came back wrong");

    // {u8, u8, u8} -> one GPR (i24)
    let b3: B3 = abi_b3(B3{ a: 10, b: 20, c: 30 });
    std.testing.assert(b3.a != 0, "B3 argument arrived wrong in C");
    std.testing.assert(b3.a == 30 && b3.b == 20 && b3.c == 10, "B3 return came back wrong");

    // {i16, i16, i16} -> one GPR (i48)
    let s3: S3 = abi_s3(S3{ a: 100, b: 200, c: 300 });
    std.testing.assert(s3.a != -1, "S3 argument arrived wrong in C");
    std.testing.assert(s3.a == 300 && s3.b == 200 && s3.c == 100, "S3 return came back wrong");

    // Coerced structs interleaved with scalars: rdi/rsi (a), xmm0 (d), xmm1/xmm2 (b), rdx (l), xmm3/rcx (c)
    let mixed: f64 = abi_mixed(III{ a: 1, b: 2, c: 3 }, 0.5, V3{ x: 1.0, y: 2.0, z: 3.0 }, 100, FFI{ x: 1.5, y: 2.5, i: 3 });
    std.testing.assert(mixed == 6.0 + 0.5 + 6.0 + 100.0 + 7.0, "mixed coerced-struct and scalar arguments arrived wrong in C");

    return 0;
}

//END CODE
