//NAME: Switch Statement Coverage
//DESC: Tests grouped cases and default handling in switch statements
//BEGIN CODE

import "stdlib" as std;

fn dispatch(x: i32) -> i32 {
  switch (x) {
    0 => {
      return 10;
    },
    1, 2 => {
      return 20;
    },
    _ => {
      return 30;
    },
  }
  return 0;
}

fn main() -> i32 {
  let a = dispatch(0);
  let b = dispatch(2);
  let c = dispatch(7);
  std.testing.assert(a == 10, "dispatch(0) should hit the 0 case and return 10");
  std.testing.assert(b == 20, "dispatch(2) should hit the grouped 1,2 case and return 20");
  std.testing.assert(c == 30, "dispatch(7) should hit the default case and return 30");
  std.testing.assert(a + b + c == 60, "sum of dispatch results should be 60");
  return 0;
}

//END CODE
