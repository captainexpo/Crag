//NAME: When Return and Loop Control
//DESC: Tests return inside when and continue/break inside loops with when
//BEGIN CODE

import "stdlib" as std;

fn main() -> i32 {
  let visited: [4]bool = {false, false, false, false};
  let steps: i32 = 0;
  for (let i: i32 = 0; i < 4; i = i + 1) {
    if (i == 1) {
      continue;
    }
    if (i == 3) {
      break;
    }
    visited[i] = true;
    steps += 1;
  }
  std.testing.assert(visited[0] == true, "i == 0 should run the loop body");
  std.testing.assert(visited[1] == false, "i == 1 should be skipped via continue");
  std.testing.assert(visited[2] == true, "i == 2 should run the loop body");
  std.testing.assert(visited[3] == false, "i == 3 should break before running the loop body");
  std.testing.assert(steps == 2, "loop body should run exactly twice (i == 0 and i == 2)");

  when true {
    return 0;
  }
  return 1;
}

//END CODE
