//NAME: Simple stdlib test
//DESC: Very bad test, should probably remove
//REQUIRES:../stdlib/libc/stdio.crag
//BEGIN CODE

import "stdio.crag" as stdio;
import "stdlib" as std;

fn main() -> i32 {
    let written: i32 = stdio.printf("%d", 15);
    std.testing.assert(written == 2, "printf('%d', 15) should print 2 characters");
    return 0;
}

//END CODE
