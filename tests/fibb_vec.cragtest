//NAME: Fibb with arraylist
//DESC:
//BEGIN CODE

import "stdlib" as std { arraylist { ArrayList } };

fn main() -> i32 {
    let a = ArrayList.new::<i64>();

    a.append(0);
    a.append(1);
    for (let i: usize = 1; i < 100; i += 1) {
        a.append(a.get(i - 1).ok + a.get(i).ok);
    }
    let expected: [7]i64 = {0, 1, 1, 2, 3, 5, 8};
    for (let i: usize = 0; i < 7; i += 1){
        std.testing.assert(a.get(i).ok == expected[i], "fibonacci value at index i should match expected");
    }
    return 0;
}

//END CODE
