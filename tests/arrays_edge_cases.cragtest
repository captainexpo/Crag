//NAME: Arrays Edge Cases
//DESC: Test array initialization and indexing
//BEGIN CODE

import "stdlib" as std;

fn main() -> i32 {
  let arr: [3]i32 = {1,2,3};
  std.testing.assert(arr[0] == 1 && arr[1] == 2 && arr[2] == 3, "initial array values should be 1, 2, 3");
  for (let i: i32 = 0; i < 3; i = i + 1) {
    arr[i] = arr[i] * 2;
  }
  std.testing.assert(arr[0] == 2 && arr[1] == 4 && arr[2] == 6, "array values should double to 2, 4, 6");
  return 0;
}

//END CODE
