//NAME: Const Eval Parity
//DESC: Ensure const-eval matches runtime evaluation for basic ops
//BEGIN CODE

import "stdlib" as std;

fn main() -> i32 {
  const a: i32 = 7;
  const b: u64 = 2;
  const c: i32 = a + b;
  const d: i32 = a - b;
  const e: i32 = a * b;
  const f: i32 = a / b;
  const g: i32 = (12 & 5) | 2;
  const h: i32 = (1 << 3) ^ 2;
  const i: bool = (a > b);
  const j: bool = (a == b);

  let ra: i32 = 7;
  let rb: u64 = 2;
  let rc: i32 = ra + rb;
  let rd: i32 = ra - rb;
  let r_mul: i32 = ra * rb;
  let rf: i32 = ra / rb;
  let rg: i32 = (12 & 5) | 2;
  let rh: i32 = (1 << 3) ^ 2;
  let ri: bool = (ra > rb);
  let rj: bool = (ra == rb);

  std.testing.assert(c == 9, "a + b should be 9");
  std.testing.assert(d == 5, "a - b should be 5");
  std.testing.assert(e == 14, "a * b should be 14");
  std.testing.assert(f == 3, "a / b should be 3");
  std.testing.assert(g == 6, "(12 & 5) | 2 should be 6");
  std.testing.assert(h == 10, "(1 << 3) ^ 2 should be 10");
  std.testing.assert(i == true, "a > b should be true");
  std.testing.assert(j == false, "a == b should be false");

  std.testing.assert(c == rc, "const and runtime addition should match");
  std.testing.assert(d == rd, "const and runtime subtraction should match");
  std.testing.assert(e == r_mul, "const and runtime multiplication should match");
  std.testing.assert(f == rf, "const and runtime division should match");
  std.testing.assert(g == rg, "const and runtime bitwise-and/or should match");
  std.testing.assert(h == rh, "const and runtime shift/xor should match");
  std.testing.assert(i == ri, "const and runtime comparison (>) should match");
  std.testing.assert(j == rj, "const and runtime comparison (==) should match");

  return 0;
}

//END CODE
