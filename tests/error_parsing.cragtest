//NAME: Error Union Parsing
//DESC:
//BEGIN CODE

import "stdlib" as std;

enum Error(i32) {
    NotFound = 404,
    Unauthorized = 401,
    InternalServerError = 500
}

struct SomeType<T> {
    a: T,
    fn foo(self: *SomeType::<T>) -> i32 {
        return 1337;
    }
}


fn bogus() -> SomeType::<i32>!Error {
    return! Error:NotFound;
}

fn main() -> i32 {
    let result = bogus();
    std.testing.assert(result.is_err, "bogus() should return an error");
    std.testing.assert((result.err as i32) == 404, "error should be Error:NotFound (404)");
    return 0;
}

//END CODE
