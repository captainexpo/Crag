//NAME: Type Inference
//DESC: Verify basic type inference for numeric expression
//BEGIN CODE

import "stdlib" as std;

fn main(argc: i32, argv: **u8) -> i32 {
  let x = 1.2 + 3; // Will be inferred as a float
  let d: f32 = x - 4.2;
  if (d < 0.0) {
    d = -d;
  }
  std.testing.assert(d < 0.0001, "1.2 + 3 should be inferred as a float and be approximately 4.2");
  return 0;
}

//END CODE
