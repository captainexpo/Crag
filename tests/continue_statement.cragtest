//NAME: Continue Statement
//DESC: Test whether the "continue" statement works in loops
//BEGIN CODE

import "stdlib" as std;

fn main(argc: i32, argv: **u8) -> i32 {
  let i: i32 = 0;
  let sum: i32 = 0;
  let count: i32 = 0;
  while (i < 5){
    i = i + 1;
    if (i == 2) continue;
    sum += i;
    count += 1;
  }
  std.testing.assert(count == 4, "continue should skip exactly one iteration (i == 2)");
  std.testing.assert(sum == 13, "sum of 1+3+4+5 should be 13");
  return 0;
}

//END CODE
