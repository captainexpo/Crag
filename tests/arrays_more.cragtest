//NAME: Arrays
//DESC: Test the array literals and stuff
//BEGIN CODE

import "stdlib" as std;

fn main(argc: i32) -> i32 {
    let arr: [3+3]u8 = {'H','E','L','L','O',0};
    other(arr.ptr);
    std.testing.assert(arr[0] == 'B', "other() should have mutated arr[0] to 'B'");
    std.testing.assert(arr.len == 6, "arr.len should be 6");
    return 0;
}

fn other(arr: *u8) -> u8 {
    arr[0] = 'B';
    return arr[0];
}

//END CODE
