//NAME: Function Pointers
//DESC:
//BEGIN CODE

import "stdlib" as std;

fn other(x: f32) -> f32 {
    return 3.5 + x;
}

fn main() -> i32 {
    let ptr: fn(f32) -> f32 = &other;
    let result: f32 = ptr(4.5);
    std.testing.assert(result == 8.0, "calling through a function pointer should compute 3.5 + 4.5 = 8.0");
    return 0;
}

//END CODE
