
//NAME: Sizeof
//DESC:
//BEGIN CODE

import "stdlib" as std;

fn main(argc: i32, argv: *const *const u8) -> i32 {
    std.testing.assert(sizeof(u8) == 1, "sizeof(u8) should be 1");
    std.testing.assert(sizeof(u32) == 4, "sizeof(u32) should be 4");
    std.testing.assert(sizeof(i64) == 8, "sizeof(i64) should be 8");
    std.testing.assert(sizeof(*void) == 8, "sizeof(*void) should be 8");
    return 0;
}

//END CODE
