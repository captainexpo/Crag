//NAME: Linked List Example
//DESC: Test linked list construction and traversal from examples/linked_list.y. This is more of an all-encompassing test
//BEGIN CODE

import "stdlib" as std;

extern fn free(_p: *u8) -> void;
extern fn malloc(_size: usize) -> *u8;

struct Node {
  val: i32,
  next: *Node,

  fn append(self: *Node, val: i32) -> void {
    let cur: *Node = self;
    while (cur.next != null) {
      cur = cur.next;
    }
    cur.next = new_node(val);
  }
}

fn new_node(val: i32) -> *Node {
  let n: *Node = malloc((4 + 8) as usize) re *Node;
  n.* = Node { val: val, next: null };
  return n;
}

fn llfree(head: *Node) -> i32 {
  let cur: *Node = head;
  while (cur != null) {
    let next: *Node = cur.next;
    free(cur re *u8);
    cur = next;
  }
  return 0;
}

fn main(argc: i32, argv: **u8) -> i32 {
  let x: *Node = new_node(42);
  x.next = new_node(43);
  x.append(44);
  x.append(45);
  x.append(46);

  let expected: [5]i32 = {42, 43, 44, 45, 46};
  let cur: *Node = x;
  let i: i32 = 0;
  while (cur != null) {
    std.testing.assert(i < 5, "linked list should not have more than 5 nodes");
    std.testing.assert(cur.val == expected[i], "linked list node value should match expected order");
    cur = cur.next;
    i = i + 1;
  }
  std.testing.assert(i == 5, "linked list should have exactly 5 nodes");

  llfree(x);
  return 0;
}

//END CODE
