//NAME: Array initialization in structs
//DESC:
//BEGIN CODE

import "stdlib" as std;

struct Test {
    arr: [256]u8,
    arr2: [128]i32,

}

fn main(argc: i32) -> i32 {
    const t = Test {
        arr: {},
        arr2: {1,2,3},
    };
    t.arr[25] = 'H';
    std.testing.assert(t.arr[25] == 'H', "assigning t.arr[25] should stick");
    std.testing.assert(t.arr2[0] == 1, "t.arr2[0] should be 1 from the initializer");
    std.testing.assert(t.arr2[2] == 3, "t.arr2[2] should be 3 from the initializer");
    std.testing.assert(t.arr2[120] == 0, "t.arr2[120] should default to 0 beyond the initializer list");
    return 0;
}


//END CODE
