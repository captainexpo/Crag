//NAME: Scoped Variables
//DESC: Self evident
//BEGIN CODE

import "stdlib" as std;

fn main(argc: i32, argv: *const *const u8) -> i32 {
    let a: i32 = 5;
    let inner_a: i32 = 0;
    {
        let a: i32 = 7;
        inner_a = a;
    }
    std.testing.assert(inner_a == 7, "inner scope's shadowed a should be 7");
    std.testing.assert(a == 5, "outer a should remain 5 after the inner scope ends");
    return 0;
}

//END CODE
