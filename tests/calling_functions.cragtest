//NAME: Calling Functions
//DESC: Test whether calling functions works

//BEGIN CODE
import "stdlib" as std;

extern fn printf(fmt: *u8, ...) -> i32;

fn print_something(something: *u8) -> i32 {
  return printf("Something: %s", something);
}

fn something_else(x: i32, y: i32) -> i32 {
  return x * x + y * y;
}

fn main() -> i32 {
  let written: i32 = print_something("This is something\n");
  std.testing.assert(written == 29, "print_something should print 29 characters");
  std.testing.assert(something_else(2, 3) == 13, "something_else(2, 3) should equal 13");
  return 0;
}

//END CODE
