//NAME: Arrays
//DESC: Test the array type
//BEGIN CODE

import "stdlib" as std;

fn main(argc: i32, argv: **u8) -> i32 {
  let arr: [5]u8 = {0};
  for (let i: i32 = 0; i < 5; i++) {
    arr[i] = i;
  }
  for (let j: i32 = 0; j < 5; j++) {
    std.testing.assert(arr[j] == (j as u8), "arr[j] should equal j");
  }
  return 0;
}

//END CODE
