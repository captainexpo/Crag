//NAME: Aliased Generic Cross Module
//DESC: Generic alias to a module-qualified generic struct, used as a struct field type
//BEGIN CODE

import "stdlib" as std;

using List<T> = std.arraylist.ArrayList::<T>;

struct Box {
    items: List::<u64>,
}

fn main() -> i32 {
    let v = std.arraylist.ArrayList.new::<u64>();
    v.append(1);
    v.append(2);
    v.append(3);
    std.testing.assert(v.len() == 3, "vec length should be 3");
    std.testing.assert(v.get(0).ok + v.get(1).ok + v.get(2).ok == 6, "vec elements should sum to 6");
    return 0;
}

//END CODE
