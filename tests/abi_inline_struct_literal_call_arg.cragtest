//NAME: ABI - Inline Struct Literal As Extern Call Argument
//DESC:
//REQUIRES_C:abi_regression_helpers.c
//BEGIN CODE

import "stdlib" as std;

struct Color {
    r: u8,
    g: u8,
    b: u8,
    a: u8,
}

extern fn sum_color(c: Color) -> i32;

fn main() -> i32 {
    // The struct literal is constructed directly in the call, not bound to a
    // `let` first -- that's what used to crash codegen.
    let total = sum_color(Color{ r: 18, g: 18, b: 22, a: 255 });
    std.testing.assert(total == 313, "sum_color(Color{18,18,22,255}) should be 313");
    return 0;
}

//END CODE
