//NAME: Hello World Stdlib
//DESC: Test whether language is able to import from stdlib as an alias
//BEGIN CODE

import "stdlib" as std;

fn main(argc: i32, argv: **u8) -> i32 {
  let written: i32 = std.cstdio.printf("Hello World!\n");
  std.testing.assert(written == 13, "printf should report 13 characters written");
  return 0;
}

//END CODE
