//NAME: Generic functions #2
//DESC:
//BEGIN CODE

import "stdlib" as std;

extern fn free(ptr: *void) -> void;
extern fn malloc(size: usize) -> *u8;

fn map<T>(arr: []T, f: fn(T) -> T) -> *T {
  let result = malloc(arr.len * sizeof(T)) as *T;
  for (let i = 0; i < arr.len; i = i + 1) {
      result[i] = f(arr[i]);
  }
  return result;
}

fn successor<T>(x: T) -> T {
  return x + 1;
}

fn main() -> i32 {
  let arr: []i32 = {1,2,3,4,5};
  let k = map::<i32>(arr, &successor::<i32>);
  let expected1: [5]i32 = {2,3,4,5,6};
  for (let i = 0; i < arr.len; i = i + 1) {
      std.testing.assert(k[i] == expected1[i], "mapped i32 successor value should match expected");
  }
  free(k);
  let arr2: []f32 = {5,4,3,2,1};
  let k1 = map::<f32>(arr2, &successor::<f32>);
  let expected2: [5]f32 = {6,5,4,3,2};
  for (let j = 0; j < arr2.len; j = j + 1) {
      std.testing.assert(k1[j] == expected2[j], "mapped f32 successor value should match expected");
  }
  free(k1);
  return 0 as i32;
}


//END CODE
