//NAME: Constant array literals
//DESC: Array literals marked constant by the typechecker keep correct values and mutability
//BEGIN CODE

import "stdlib" as std;

const N: i32 = 1;
let g: [3]i32 = {1, 2, 3};
const cg: [2]i32 = {7, 8};

fn make() -> i32 {
  let a: [3]i32 = {10, 20 + 1, -3};
  let r: i32 = a[0] + a[1] + a[2];
  a[0] = 1000;
  return r;
}

fn shadow(x: i32) -> i32 {
  let N: i32 = x;
  let a: [2]i32 = {N, N + 1};
  return a[1];
}

fn scribble() -> i32 {
  let a: [8]i32 = {-1, -1, -1, -1, -1, -1, -1, -1};
  return a[0] + a[7];
}

fn partialFill() -> i32 {
  let a: [8]i32 = {1, 2};
  return a[2] + a[3] + a[4] + a[5] + a[6] + a[7];
}

fn main(argc: i32, argv: **u8) -> i32 {
  std.testing.assert(make() == 28, "fold");
  std.testing.assert(make() == 28, "fresh copy");
  std.testing.assert(shadow(41) == 42, "shadow");
  g[0] = 9;
  std.testing.assert(g[0] == 9 && g[2] == 3, "global");
  std.testing.assert(cg[1] == 8, "const global");
  const c: [3]i32 = {4, 5, 6};
  std.testing.assert(c[2] == 6, "local const");
  const c2: [2]i32 = {N, N + 1};
  std.testing.assert(c2[1] == 2, "const from const");
  const partial: [4]i32 = {1, 2};
  std.testing.assert(partial[1] == 2 && partial[3] == 0, "partial const");
  scribble();
  let zeroed: i32 = partialFill();
  std.testing.assert(zeroed == 0, "partial literal zero-fills trailing elements");
  let u: [2]u8 = {1, 200};
  std.testing.assert(u[1] == 200, "u8");
  let f: [2]f64 = {1.5, 2.5};
  std.testing.assert(f[1] == 2.5, "f64");
  let s = {"a", "bc"};
  std.testing.assert(s[1].len == 2, "str");
  let inf = {1, 2, 3};
  std.testing.assert(inf[2] == 3, "inferred");
  let v: i32 = argc;
  let nc = {v, 2};
  std.testing.assert(nc[0] == argc, "non const");
  let nest: [2][2]i32 = {{1, 2}, {3, 4}};
  nest[1][0] = 9;
  std.testing.assert(nest[1][0] == 9, "nested");
  return 0;
}

//END CODE
