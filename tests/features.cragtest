//NAME: Features
//DESC: A miscelanneous collection of language features
//BEGIN CODE

import "stdlib" as std;

fn for_loop_sum() -> i32 {
  let sum: i32 = 0;
  for (let i: i32 = 0; i < 3; i = i + 1) {
    sum += i;
  }
  return sum;
}

fn while_loop_sum() -> i32 {
  let i: i32 = 0;
  let sum: i32 = 0;
  while (i < 3) {
    sum += i;
    i = i + 1;
  }
  return sum;
}

fn other_function(x: i32) -> i32 {
  return 42;
}

fn function_pointers_result() -> i32 {
  let f: fn(i32) -> i32 = &other_function;
  return f(25);
}

fn main(argc: i32, argv: **u8) -> i32 {
  std.testing.assert(for_loop_sum() == 3, "for loop summing 0+1+2 should be 3");
  std.testing.assert(while_loop_sum() == 3, "while loop summing 0+1+2 should be 3");
  std.testing.assert(function_pointers_result() == 42, "calling through a function pointer should return 42");
  return 0;
}

//END CODE
