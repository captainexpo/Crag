//NAME: UNIONS 1
//DESC:
//BEGIN CODE

import "stdlib" as std;

struct Test {
    x: f64,
    y: f64,
}

union Vals {
    a: f32,
    b: i64,
    T: Test,
}

fn main() -> i32 {
    let v: Vals;
    v.a = 4.0;
    v.T = Test {
        x: 5.0,
        y: 2.0,
    };
    std.testing.assert(v.b == 4617315517961601024, "v.b should read the bit pattern of Test.x (5.0 as f64) through the union");
    return 0;
}


//END CODE
