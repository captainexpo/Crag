//NAME: ABI - Multiple Struct-By-Value Arguments In One Call
//DESC:
//REQUIRES_C:abi_regression_helpers.c
//BEGIN CODE

import "stdlib" as std;

struct V2 {
    x: f32,
    y: f32,
}

struct Color {
    r: u8,
    g: u8,
    b: u8,
    a: u8,
}

struct Tex {
    id: u32,
    w: i32,
    h: i32,
    mip: i32,
    fmt: i32,
}

struct Big {
    a: i32,
    b: i32,
    c: i32,
    tex: Tex,
    p1: *void,
    p2: *void,
}

extern fn make_big(seed: i32) -> Big;
extern fn combine_v2_and_color(pos: V2, tint: Color) -> i32;
extern fn combine_big_v2_color(big: Big, extra: i32, pos: V2, tint: Color) -> i32;

fn main() -> i32 {
    let pos: V2 = V2{ x: 3, y: 4 };
    let tint: Color = Color{ r: 10, g: 20, b: 30, a: 40 };

    let sum1: i32 = combine_v2_and_color(pos, tint);
    std.testing.assert(sum1 == 3 + 4 + 10 + 20 + 30 + 40, "combine_v2_and_color should see both struct args intact");

    let big: Big = make_big(0);
    let sum2: i32 = combine_big_v2_color(big, 5, pos, tint);
    // big.tex.h (12) + extra (5) + pos.x (3) + pos.y (4) + tint.r (10) + tint.a (40)
    std.testing.assert(sum2 == 12 + 5 + 3 + 4 + 10 + 40, "combine_big_v2_color should see all three struct args (byval Big, Vector2, Color) intact alongside a scalar");

    return 0;
}

//END CODE
