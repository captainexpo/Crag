//NAME: Errors Example
//DESC: Test error-union behavior for a divide() function that can fail
//BEGIN CODE

import "stdlib" as std;

enum MyError(i32) {
  DivisionByZero = 0,
  Unknown = 1,
}

fn divide(a: i32, b: i32) -> i32!MyError {
  if (b == 0) {
    return! MyError:DivisionByZero;
  }
  return a / b;
}

fn main() -> i32 {
  let r1: i32!MyError = divide(10, 2);
  std.testing.assert(!r1.is_err, "divide(10, 2) should not error");
  std.testing.assert(r1.ok == 5, "divide(10, 2) should equal 5");

  let r2: i32!MyError = divide(10, 0);
  std.testing.assert(r2.is_err, "divide(10, 0) should error");
  std.testing.assert(r2.err == MyError:DivisionByZero, "divide(10, 0) should error with DivisionByZero");

  let r3: i32!MyError = divide(10, 5);
  std.testing.assert(!r3.is_err, "divide(10, 5) should not error");
  std.testing.assert(r3.ok == 2, "divide(10, 5) should equal 2");

  return 0;
}

//END CODE
