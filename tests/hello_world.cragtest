//NAME: Hello World
//DESC: Test whether language is able to print "Hello World!\n" and return 0
//BEGIN CODE

extern fn printf(fmt: *u8, ...) -> i32;
import "stdlib" as std;

fn main(argc: i32, argv: **u8) -> i32 {
  let written: i32 = printf("Hello World!\n");
  std.testing.assert(written == 13, "printf should report 13 characters written");
  return 0;
}

//END CODE
