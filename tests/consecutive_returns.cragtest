//NAME: Consecutive Returns
//DESC: Tests that a return statement stops execution before reaching later, unreachable code
//BEGIN CODE

import "stdlib" as std;

fn check() -> i32 {
  return 1;
  return 2;
}

fn main() -> i32 {
  std.testing.assert(check() == 1, "the first return should stop execution before the second return");
  return 0;
}

//END CODE
