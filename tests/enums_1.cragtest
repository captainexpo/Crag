//NAME: Simple Enums
//DESC: Verify enum values and boolean-backed enums
//BEGIN CODE

import "stdlib" as std;

enum EnumCode(i32) {
    A = 1,
    B, // automatically set to 2
    C = 3,
}

enum OtherEnum(bool) {
    X = true,
    Y = false,
}

fn main(argc: i32, argv: **u8) -> i32 {
    let a = EnumCode:A;
    let b = EnumCode:B;
    let c = EnumCode:C;

    std.testing.assert((a as i32) == 1, "EnumCode:A should equal 1");
    std.testing.assert((b as i32) == 2, "EnumCode:B should auto-increment to 2");
    std.testing.assert((c as i32) == 3, "EnumCode:C should equal 3");

    let x = OtherEnum:X;
    let y = OtherEnum:Y;
    let bx: bool = x;
    let by: bool = y;

    std.testing.assert(bx == true, "OtherEnum:X should equal true");
    std.testing.assert(by == false, "OtherEnum:Y should equal false");

    return 0;
}

//END CODE
