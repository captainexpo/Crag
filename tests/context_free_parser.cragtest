//NAME: Context-Free Parser Regression
//DESC:
//BEGIN CODE

import "stdlib" as std;

struct Ring {
    next: *Node,
}

struct Node {
    ring: *Ring,
    value: i32,
}

fn main() -> i32 {
    let n: Node;
    n.value = 42;
    std.testing.assert(n.value == 42, "ordinary local field access should still work");

    let v = std.arraylist.ArrayList.new::<i32>();
    v.append(10);
    v.append(20);
    std.testing.assert(v.len() == 2, "cross-module generic type + dotted turbofish instantiation should work");
    std.testing.assert(v.get(0).ok == 10, "v[0] should be 10");
    std.testing.assert(v.get(1).ok == 20, "v[1] should be 20");
    v.deinit();

    return 0;
}

//END CODE
