//NAME: Generics Inference
//DESC: Test generic function inference and type mixing
//BEGIN CODE

import "stdlib" as std;

fn id<T>(x: T) -> T {
  return x;
}

fn main() -> i32 {
  let a: i32 = id::<i32>(5);
  let b = id::<f64>(3.5);
  std.testing.assert(a == 5, "id::<i32>(5) should return 5");
  std.testing.assert(b == 3.5, "id::<f64>(3.5) should return 3.5");
  return 0;
}

//END CODE
