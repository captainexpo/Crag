//NAME: Arena
//DESC:
//BEGIN CODE

import "stdlib" as std;

fn main() -> i32 {
    let arena = std.arena.arena_new(1024);

    for (let i: usize = 0; i < 16; i++){
        arena.alloc(32);
    }

    std.testing.assert(arena.used == 512, "arena.used after 16 allocations of 32 bytes should be 512");
    arena.reset();
    std.testing.assert(arena.used == 0, "arena.used after reset() should be 0");
    arena.destroy();
    return 0;
}

//END CODE
