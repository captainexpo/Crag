//NAME: Switch On Isize
//DESC: Tests switch conditions using the isize type
//BEGIN CODE

import "stdlib" as std;

fn classify(x: isize) -> i32 {
  switch (x) {
    -1 => {
      return 1;
    },
    0 => {
      return 2;
    },
    _ => {
      return 3;
    },
  }
  return 0;
}

fn main() -> i32 {
  let a = classify(-1);
  let b = classify(0);
  let c = classify(9);
  std.testing.assert(a == 1, "classify(-1) should return 1");
  std.testing.assert(b == 2, "classify(0) should return 2");
  std.testing.assert(c == 3, "classify(9) should return 3");
  return 0;
}

//END CODE
