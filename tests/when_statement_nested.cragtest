//NAME: When Statement Nested
//DESC: Test nested when statements and nested block lowering.
//BEGIN CODE

import "stdlib" as std;

struct Trace {
  steps: [8]i32,
  n: i32,
}

fn record(t: *Trace, marker: i32) -> void {
  t.steps[t.n] = marker;
  t.n = t.n + 1;
}

fn main() -> i32 {
  let t: Trace = Trace { steps: {0}, n: 0 };
  when true {
    record(&t, 1); // outer-a
    when true {
      record(&t, 2); // inner-a
      when false record(&t, 99); // inner-skip
      when true record(&t, 3); // inner-b
    }
    record(&t, 4); // outer-b
  }
  std.testing.assert(t.n == 4, "exactly 4 steps should have executed");
  std.testing.assert(t.steps[0] == 1 && t.steps[1] == 2 && t.steps[2] == 3 && t.steps[3] == 4,
    "nested when-true branches should execute in order and when-false branches should be skipped");
  return 0;
}

//END CODE
