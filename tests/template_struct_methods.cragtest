//NAME: Generic Struct Methods
//DESC: Test methods on a generic struct instantiated at multiple types
//BEGIN CODE

import "stdlib" as std;

struct Test<T> {
    val: T,
    fn get(self: *Test::<T>) -> T {
        return self.val;
    }
}

fn main(argc: i32, argv: **u8) -> i32 {
    let test = Test::<i32> { val: 3 };
    std.testing.assert(test.get() == 3, "Test::<i32>.val should be 3");
    let test2 = Test::<i64> { val: 10 };
    std.testing.assert(test2.get() == 10, "Test::<i64>.val should be 10");
    return 0;
}

//END CODE
