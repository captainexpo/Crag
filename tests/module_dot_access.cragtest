//NAME: Module Dot Access
//DESC: Dot-style module access for values and types
//REQUIRES:mod_test_requires/mod_math.crag
//BEGIN CODE

import "stdlib" as std;
import "mod_math.crag" as math;

fn main() -> i32 {
    let v: math.Vec2 = math.Vec2{x: 2, y: 4};
    std.testing.assert(math.C + math.add(v) == 7, "math.C + math.add(v) should be 7");
    return 0;
}

//END CODE
