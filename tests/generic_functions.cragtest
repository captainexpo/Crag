//NAME: Simple generics
//DESC:
//BEGIN CODE

import "stdlib" as std;

fn add<A, B>(a: A, b: B) -> B {
    return b + a;
}


fn main() -> i32 {
    let a: f32 = add::<i32, f32>(7, 7.5);
    let b: i32 = add::<i32, i32>(3, 4);
    std.testing.assert(a == 14.5, "add::<i32, f32>(7, 7.5) should be 14.5");
    std.testing.assert(b == 7, "add::<i32, i32>(3, 4) should be 7");
    std.testing.assert(add::<i32, i32>(10, 20) == 30, "add::<i32, i32>(10, 20) should be 30");
    return 0;
}


//END CODE
