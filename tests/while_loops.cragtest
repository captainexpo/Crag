//NAME: While Loops
//DESC: Test whether while loops work

//BEGIN CODE
import "stdlib" as std;

fn main() -> i32 {
  let i: i32 = 1;
  let j: i32 = 0;
  while (i < 10) {
    i = i * 2;
    j = j + 1;
  }
  std.testing.assert(i == 16, "doubling from 1 while < 10 should stop at 16");
  std.testing.assert(j == 4, "doubling from 1 to 16 should take 4 iterations");
  return 0;
}

//END CODE
