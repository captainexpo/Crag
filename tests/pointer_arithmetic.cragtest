//NAME: Pointer Arithmetic
//DESC: Test pointer arithmetic, dereferencing, and slices
//BEGIN CODE

import "stdlib" as std;

fn main(argc: i32, argv: **u8) -> i32 {
    let hello = "Hello World!";
    let buf: [14]u8 = {0};
    std.cstring.memcpy(buf.ptr, hello, 12);
    buf[12] = '\n';
    buf[13] = 0;
    std.testing.assert(buf[0] == 'H' && buf[11] == '!' && buf[12] == '\n' && buf[13] == 0, "buf should hold 'Hello World!' followed by a newline and NUL");

    let arr2: [5]i32 = {1,2,3,4,5};
    let view: []i32 = slice(arr2.ptr, 5);
    std.testing.assert(arr2.ptr.* == 1, "dereferencing arr2.ptr should give the first element, 1");
    std.testing.assert((arr2.ptr + sizeof(i32)).* == 2, "advancing arr2.ptr by sizeof(i32) should give the second element, 2");
    std.testing.assert(view.len == 5, "view.len should be 5");
    std.testing.assert(view[2] == 3, "view[2] should be 3");

    return 0;
}


//END CODE
