//NAME: Break Statement
//DESC: Test whether the "break" statement works in loops
//BEGIN CODE

import "stdlib" as std;

fn main(argc: i32, argv: **u8) -> i32 {
  let i: i32 = 0;
  while (true){
    while (true) break;
    if (i == 3) break;
    i = i + 1;
  }
  std.testing.assert(i == 3, "inner break should only exit the inner loop, outer loop should stop at i == 3");
  return 0;
}

//END CODE
